# ===========================================
# 生产环境配置模板
# ===========================================
#
# 使用说明:
# 1. 复制此文件为 .env.production.local
# 2. 填写所有必需的配置值
# 3. 确保 .env.production.local 已添加到 .gitignore
# 4. 生成安全密钥: npm run generate:secrets
#
# ===========================================

# 应用配置
NODE_ENV=production
PORT=3000

# 数据库配置
# 注意: 请使用强密码，避免使用默认值
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=wordle_db
POSTGRES_PORT=5432

# 数据库连接 URL（可选，如果设置将优先使用）
# DATABASE_URL=postgresql://postgres:password@postgres:5432/wordle_db

# Redis 配置
REDIS_PORT=6379
# REDIS_URL=redis://redis:6379

# 安全密钥配置
# ⚠️ 重要: 必须修改这些值！
# 使用 npm run generate:secrets 生成强密钥
ADMIN_SECRET=CHANGE_ME_USE_GENERATE_SECRETS_SCRIPT
ENCRYPTION_SECRET=CHANGE_ME_USE_GENERATE_SECRETS_SCRIPT

# 日志配置
# 可选值: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Nginx 配置
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# 应用端口映射（外部访问端口）
APP_PORT=3000

# Docker 镜像版本
VERSION=latest

# ===========================================
# 可选配置
# ===========================================

# 域名配置（用于 SSL 证书）
# DOMAIN=your-domain.com

# 备份配置
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *

# 监控配置
# ENABLE_METRICS=true
# METRICS_PORT=9090
